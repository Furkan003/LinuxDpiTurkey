<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/software/polkit/policyconfig-1.dtd">
<!--
  Yetki penceresinde kullanıcının ne onayladığını anlaması için.
  Bu dosya olmadan pkexec genel bir metin gösterir; bir ağ aracı için
  "ne yapacağını bilmediğin bir programa root ver" demek yeterli değil.

  auth_admin_keep: parola bir kez sorulur, kısa süre hatırlanır.
  Başlat/durdur arasında tekrar tekrar sormaz.
-->
<policyconfig>
  <vendor>TR-DPI</vendor>
  <vendor_url>https://github.com/</vendor_url>

  <action id="tr.trdpi.run">
    <description>Bağlantı korumasını çalıştır</description>
    <description xml:lang="en">Run connection protection</description>
    <message>Bağlantı korumasını başlatmak için yönetici izni gerekiyor.</message>
    <message xml:lang="en">Administrator access is required to start connection protection.</message>

    <defaults>
      <allow_any>auth_admin_keep</allow_any>
      <allow_inactive>auth_admin_keep</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>

    <annotate key="org.freedesktop.policykit.exec.path">/usr/bin/trdpi</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
